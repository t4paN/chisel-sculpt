// block_boxes.comp — GLSL 430 sibling of shaders/wgsl/block_boxes.wgsl.
// One world AABB per 64-vertex index block, built from GPU-side positions so it can
// never be stale (a stale box is too small, which drops vertices out of a dab).
#version 430
layout(local_size_x = 64) in;

layout(std430, binding = 0)  readonly buffer PosBuf  { float positions[]; };
layout(std430, binding = 47)          buffer BoxBuf  { float boxes[]; };

layout(std140, binding = 63) uniform Params {
    uint vertex_count;
    uint block_count;
    uint _pad0;
    uint _pad1;
} P;

void main() {
    uint b = gl_GlobalInvocationID.x;
    if (b >= P.block_count) return;

    uint v0 = b * 64u;
    uint v1 = min(v0 + 64u, P.vertex_count);

    vec3 lo = vec3( 1e30);
    vec3 hi = vec3(-1e30);
    for (uint v = v0; v < v1; v++) {
        vec3 p = vec3(positions[v * 3u], positions[v * 3u + 1u], positions[v * 3u + 2u]);
        lo = min(lo, p);
        hi = max(hi, p);
    }
    uint o = b * 6u;
    boxes[o + 0u] = lo.x; boxes[o + 1u] = lo.y; boxes[o + 2u] = lo.z;
    boxes[o + 3u] = hi.x; boxes[o + 4u] = hi.y; boxes[o + 5u] = hi.z;
}
