// remesh_smooth.comp — GLSL 430 sibling of shaders/wgsl/remesh_smooth.wgsl.
// Remesh tangential Laplacian (GPU ping-pong): each in-region, non-pinned, weighted
// vertex moves toward its 1-ring centroid with the normal component stripped (tangential
// only — a full Laplacian shrinks the form). Seam x is clamped so non-pinned verts can't
// drift into / across the seam band. Pinned / out-of-region / weightless / degenerate-
// normal verts pass through. 16-byte std140 Params UBO at binding 63.
// binding 4 (adj_csr) is a CSR-concatenated copy of the shared adjacency
// offset+list buffers — see remesh_smooth.wgsl's header comment and
// remesh_adj_csr_ssbo in include/compute.h. Kept in lockstep with the WGSL
// sibling even though GL has no 8-storage-buffer cap of its own.
#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 0)           buffer OutPosBuf  { float out_pos[]; };
layout(std430, binding = 1)  readonly buffer NormBuf    { float normals[]; };
layout(std430, binding = 2)  readonly buffer IdxBuf     { uint  indices[]; };
layout(std430, binding = 4)  readonly buffer AdjCsrBuf  { uint  adj_csr[];  };
layout(std430, binding = 13) readonly buffer InPosBuf   { float in_pos[];   };
layout(std430, binding = 14) readonly buffer WeightBuf  { float weights[];  };
layout(std430, binding = 15) readonly buffer PinnedBuf  { uint  pinned[];   };
layout(std430, binding = 16) readonly buffer TriSelBuf  { uint  tri_sel[];  };

layout(std140, binding = 63) uniform Params {
    float lambda;        // 0
    float seam_tol;      // 4
    uint  vertex_count;  // 8
    uint  _pad0;         // 12
} P;

void main() {
    uint v = gl_GlobalInvocationID.x;
    if (v >= P.vertex_count) return;

    out_pos[v*3u+0u] = in_pos[v*3u+0u];
    out_pos[v*3u+1u] = in_pos[v*3u+1u];
    out_pos[v*3u+2u] = in_pos[v*3u+2u];

    if (pinned[v] != 0u) return;

    float w = weights[v];
    if (w < 1e-6) return;

    // adj_csr[0 .. vertex_count] is the offset array; the list starts right after.
    uint list_base = P.vertex_count + 1u;
    uint t_start = adj_csr[v];
    uint t_end   = adj_csr[v + 1u];

    bool in_region = false;
    for (uint j = t_start; j < t_end; j++) {
        if (tri_sel[adj_csr[list_base + j]] != 0u) { in_region = true; break; }
    }
    if (!in_region) return;

    uint nbrs[48];
    uint nbr_count = 0u;
    for (uint j = t_start; j < t_end; j++) {
        uint t = adj_csr[list_base + j];
        for (int k = 0; k < 3; k++) {
            uint n = indices[t*3u + uint(k)];
            if (n == v) continue;
            bool found = false;
            for (uint l = 0u; l < nbr_count; l++) {
                if (nbrs[l] == n) { found = true; break; }
            }
            if (!found && nbr_count < 48u) nbrs[nbr_count++] = n;
        }
    }
    if (nbr_count == 0u) return;

    vec3 nbr_centroid = vec3(0.0);
    for (uint l = 0u; l < nbr_count; l++) {
        nbr_centroid.x += in_pos[nbrs[l]*3u+0u];
        nbr_centroid.y += in_pos[nbrs[l]*3u+1u];
        nbr_centroid.z += in_pos[nbrs[l]*3u+2u];
    }
    nbr_centroid /= float(nbr_count);

    // Area-weighted centroid of the ring's tris. The plain neighbour average
    // settles wherever the ring is balanced by COUNT, which leaves big and small
    // tris side by side; weighting by area pulls each vert toward its larger
    // tris until they even out. Only on a near-flat ring (every tri within 30
    // degrees of the vertex normal) and away from the seam: on a knife crest or
    // next to the fenced seam band the pull stretched edges and bred slivers.
    // seam_tol is 1% of the target edge, so 150x = 1.5 edges.
    vec3 vn = vec3(normals[v*3u+0u], normals[v*3u+1u], normals[v*3u+2u]);
    float vn_len = length(vn);
    bool ring_flat = abs(in_pos[v*3u]) > 150.0 * P.seam_tol && vn_len > 1e-12;
    vec3 area_acc = vec3(0.0);
    float area_sum = 0.0;
    for (uint j = t_start; j < t_end && ring_flat; j++) {
        uint t = adj_csr[list_base + j];
        uint i0 = indices[t*3u], i1 = indices[t*3u+1u], i2 = indices[t*3u+2u];
        vec3 p0 = vec3(in_pos[i0*3u], in_pos[i0*3u+1u], in_pos[i0*3u+2u]);
        vec3 p1 = vec3(in_pos[i1*3u], in_pos[i1*3u+1u], in_pos[i1*3u+2u]);
        vec3 p2 = vec3(in_pos[i2*3u], in_pos[i2*3u+1u], in_pos[i2*3u+2u]);
        vec3 tn = cross(p1 - p0, p2 - p0);
        float tl = length(tn);
        if (tl < 1e-30 || dot(tn, vn) < 0.866 * tl * vn_len) ring_flat = false;
        area_acc += tl * (p0 + p1 + p2) / 3.0;
        area_sum += tl;
    }
    if (ring_flat && area_sum > 1e-30) nbr_centroid = area_acc / area_sum;

    vec3 pos = vec3(in_pos[v*3u+0u], in_pos[v*3u+1u], in_pos[v*3u+2u]);
    // A degenerate (zero-length) vertex normal has no tangent plane to project onto.
    // normalize() of a zero vector is 0/0 -> NaN, which leaks into out_pos and poisons
    // the post-remesh mirror rebuild. Bail out leaving the vertex put when that happens.
    vec3 nrm_raw = vec3(normals[v*3u+0u], normals[v*3u+1u], normals[v*3u+2u]);
    float nrm_len = length(nrm_raw);
    if (nrm_len < 1e-12) {
        out_pos[v*3u+0u] = pos.x;
        out_pos[v*3u+1u] = pos.y;
        out_pos[v*3u+2u] = pos.z;
        return;
    }
    vec3 nrm = nrm_raw / nrm_len;
    vec3 d   = nbr_centroid - pos;
    vec3 td  = d - nrm * dot(d, nrm);

    float new_x = pos.x + td.x * (P.lambda * w);
    // Non-pinned verts are outside the seam band by construction. Keep them there:
    // don't allow smoothing to drift |x| into the band or flip sides.
    new_x = sign(pos.x) * max(P.seam_tol, abs(new_x));

    out_pos[v*3u+0u] = new_x;
    out_pos[v*3u+1u] = pos.y + td.y * (P.lambda * w);
    out_pos[v*3u+2u] = pos.z + td.z * (P.lambda * w);
}
