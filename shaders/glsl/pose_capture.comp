// pose_capture.comp — GLSL 430 sibling of shaders/wgsl/pose_capture.wgsl.
// Pass 1 of the pose brush (once at pen-down). A vertex joins the stroke when any
// bone that moves (one end is the grabbed sphere) reaches it; its position is
// snapshotted and its id appended to the compact affected list.
// 3600-byte std140 Params UBO at binding 63. Bone + bone_weight() are copied
// verbatim into pose_apply.comp; keep them identical.
#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 0)  readonly buffer PosBuf { float positions[]; };
layout(std430, binding = 8)  buffer AffectedBuf     { uint affected_count; uint affected_ids[]; };
layout(std430, binding = 11) buffer InitBuf         { float move_init[]; };

struct Bone {
    vec4 a;    // joint A xyz at pen-down, .w = its radius
    vec4 b;    // joint B xyz at pen-down, .w = its radius
    vec4 f;    // the end that stays put, xyz; .w = 1 if this bone moves
    vec4 r0;   // rotation, column 0; .w = bone length at pen-down
    vec4 r1;   // rotation, column 1; .w = stretch along the bone
    vec4 r2;   // rotation, column 2
    vec4 u;    // unit axis, fixed end -> moving end, at pen-down
};

layout(std140, binding = 63) uniform Params {
    uint  bone_count;     // 0
    uint  vertex_count;   // 4
    float soft;           // 8   falloff past a sphere's skin, in radii
    uint  _pad0;          // 12
    Bone  bones[32];      // 16, 112 bytes each
} P;

float bone_weight(vec3 p, uint i) {
    vec3 a = P.bones[i].a.xyz;
    vec3 ab = P.bones[i].b.xyz - a;
    float len2 = max(dot(ab, ab), 1e-12);
    float t = clamp(dot(p - a, ab) / len2, 0.0, 1.0);
    float r = mix(P.bones[i].a.w, P.bones[i].b.w, t);
    float d = distance(p, a + ab * t);
    float edge = r * (1.0 + P.soft);
    if (d >= edge) return 0.0;
    if (d <= r) return 1.0;
    float x = (d - r) / max(edge - r, 1e-8);
    x = x * x * (3.0 - 2.0 * x);
    return 1.0 - x;
}

void main() {
    uint v = gl_GlobalInvocationID.x;
    if (v >= P.vertex_count) return;
    vec3 p = vec3(positions[v*3u], positions[v*3u+1u], positions[v*3u+2u]);

    bool hit = false;
    for (uint i = 0u; i < P.bone_count; i++) {
        if (P.bones[i].f.w > 0.5 && bone_weight(p, i) > 0.0) { hit = true; break; }
    }
    if (!hit) return;

    move_init[v*3u]      = p.x;
    move_init[v*3u + 1u] = p.y;
    move_init[v*3u + 2u] = p.z;
    uint idx = atomicAdd(affected_count, 1u);
    affected_ids[idx] = v;
}
