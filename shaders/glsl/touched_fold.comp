// touched_fold.comp — GLSL 430 sibling of shaders/wgsl/touched_fold.wgsl.
// Folds a {count, ids[]} source list into a deduped, GPU-resident touched list, so the
// stroke's touched set never has to be read back per dab. Per-vertex stamp dedupe,
// same as normals_expand. Destination: [0] overflow flag, [1] count, [2..] ids.
#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 6)  readonly buffer SrcBuf    { uint src[]; };
layout(std430, binding = 7)  readonly buffer MirrorBuf { uint mirror_map[]; };
layout(std430, binding = 49)          buffer MarkBuf   { uint mark[]; };
layout(std430, binding = 50)          buffer DstBuf    { uint dst[]; };

layout(std140, binding = 61) uniform Region {
    uint base;
    uint cap;
    uint _p0;
    uint _p1;
} R;

layout(std140, binding = 63) uniform Params {
    uint stamp;          // this list's claim value; never 0 (0 = never claimed)
    uint vertex_count;   // also the destination's id capacity
    uint use_mirror;     // 1 = also claim each id's pair-map twin
    uint _pad;
} P;

void claim(uint w) {
    if (w >= P.vertex_count) return;
    uint prev = atomicExchange(mark[w], P.stamp);
    if (prev == P.stamp) return;
    uint slot = atomicAdd(dst[1], 1u);
    if (slot < P.vertex_count) dst[2u + slot] = w;
}

void main() {
    uint raw = src[R.base];
    uint i = gl_GlobalInvocationID.x;
    // A source region whose counter ran past its cap lost its surplus ids; flag it so
    // the CPU falls back to a whole-mesh entry.
    if (i == 0u && raw > R.cap) atomicMax(dst[0], 1u);
    uint n = min(raw, R.cap);
    if (i >= n) return;
    uint v = src[R.base + 1u + i];
    claim(v);

    // Pair-map mirror: mirror_project moved v's twin without listing it.
    if (P.use_mirror == 1u && v < P.vertex_count) {
        uint mv = mirror_map[v];
        if (mv != v) claim(mv);
    }
}
