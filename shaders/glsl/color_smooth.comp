// color_smooth.comp — GLSL 430 sibling of shaders/wgsl/color_smooth.wgsl.
// Paint-smooth: the smooth gesture while a paint brush is active. Blends each
// in-radius vertex's colour toward the average of its 1-ring neighbours (CSR
// adjacency over incident tris) by strength*falloff. Same dual-anchor mirror +
// mask-shield as paint; in-place neighbour reads are Gauss-Seidel-racy across
// invocations exactly like the geometry smooth — harmless for a colour blur.
// Blend (paint mode's directional blur) is the same pass with flow_amt > 0: each
// neighbour is weighted by how far upstream of the vertex it sits along `flow`, so
// colour is carried forward along the stroke. flow_amt = 0 is the plain smooth.
// 64-byte std140 Params UBO at binding 63.
#version 430
layout(local_size_x = 64) in;

layout(std430, binding = 0)  readonly buffer PosBuf   { float positions[]; };
layout(std430, binding = 28) buffer ColorBuf          { uint color_buf[]; };
layout(std430, binding = 12) readonly buffer MaskBuf  { float mask_buf[]; };
layout(std430, binding = 6)  buffer DirtyBuf          { uint dirty_data[]; };
layout(std430, binding = 2)  readonly buffer IdxBuf   { uint indices[]; };
layout(std430, binding = 4)  readonly buffer AdjOffset{ uint adj_offset[]; };
layout(std430, binding = 5)  readonly buffer AdjList  { uint adj_list[]; };

layout(std430, binding = 45) readonly buffer BlockListBuf { uint block_list[]; };

layout(std140, binding = 61) uniform DirtyRegion {
    uint base;   // word offset of this dab's region inside the arena
    uint cap;    // ids it can hold; the counter runs past this
    uint block_mode;   // 1 = one workgroup per active block
    uint _p1;
} DR;

layout(std140, binding = 63) uniform Params {
    vec3  anchor_a;       // 0   (world_radius packs into .w)
    float world_radius;   // 12
    vec3  anchor_b;       // 16  (hardness packs into .w)
    float hardness;       // 28
    float strength;       // 32
    uint  use_b;          // 36
    uint  vertex_count;   // 40
    uint  _pad0;          // 44
    vec3  flow;           // 48  stroke direction, unit (lobe B mirrors x)
    float flow_amt;       // 60  0 = plain smooth, 1 = upstream only (struct = 64)
} P;

float brush_falloff(float dist, float radius) {
    float t = dist / radius;
    float inner = 0.15 + P.hardness * 0.55;
    if (t <= inner) return 1.0;
    float blend = (t - inner) / (1.0 - inner + 1e-6);
    blend = blend * blend * (3.0 - 2.0 * blend);
    return 1.0 - blend;
}

float anchor_weight(vec3 anchor, vec3 vp) {
    if (P.use_b != 0u && anchor.x * vp.x < 0.0) return 0.0;
    float dist = length(vp - anchor);
    if (dist >= P.world_radius) return 0.0;
    return brush_falloff(dist, P.world_radius);
}

// How much neighbour n counts toward v's blend. Plain smooth: all equally.
float nb_weight(uint n, vec3 vp, vec3 flow) {
    if (P.flow_amt <= 0.0) return 1.0;
    vec3 e = vec3(positions[n*3u], positions[n*3u+1u], positions[n*3u+2u]) - vp;
    float len = length(e);
    if (len <= 1e-12) return 0.0;
    float up = max(dot(e / len, -flow), 0.0);   // > 0: n sits behind v along the stroke
    return mix(1.0, up, P.flow_amt);
}
void main() {
    // Dispatch culling: one workgroup per ACTIVE block; entry 0 is the count, hence +1.
    uint v = (DR.block_mode == 1u)
           ? (block_list[1u + gl_WorkGroupID.x] * 64u + gl_LocalInvocationID.x)
           : gl_GlobalInvocationID.x;
    if (v >= P.vertex_count) return;

    vec3 vp = vec3(positions[v*3u], positions[v*3u+1u], positions[v*3u+2u]);
    float wa = anchor_weight(P.anchor_a, vp);
    float wb = (P.use_b != 0u) ? anchor_weight(P.anchor_b, vp) : 0.0;
    float w = max(wa, wb);
    vec3 flow = P.flow;
    if (wb > wa) flow.x = -flow.x;   // the mirror lobe drags the reflected way
    if (w <= 0.0) return;

    w *= (1.0 - clamp(mask_buf[v], 0.0, 1.0));   // mask shields paint-smooth too
    if (w <= 0.0) return;

    vec4 sum = vec4(0.0);   // premultiplied RGBA: coverage blurs along with colour
    float count = 0.0;
    uint start = adj_offset[v];
    uint end   = adj_offset[v + 1u];
    for (uint j = start; j < end; j++) {
        uint t = adj_list[j];
        uint i0 = indices[t*3u]; uint i1 = indices[t*3u+1u]; uint i2 = indices[t*3u+2u];
        uint n0, n1;
        if      (v == i0) { n0 = i1; n1 = i2; }
        else if (v == i1) { n0 = i0; n1 = i2; }
        else              { n0 = i0; n1 = i1; }
        float w0 = nb_weight(n0, vp, flow);
        float w1 = nb_weight(n1, vp, flow);
        sum += unpackUnorm4x8(color_buf[n0]) * w0;
        sum += unpackUnorm4x8(color_buf[n1]) * w1;
        count += w0 + w1;
    }
    if (count <= 1e-6) return;

    vec4 avg     = sum / count;
    vec4 old_c   = unpackUnorm4x8(color_buf[v]);
    float a      = clamp(P.strength * w, 0.0, 1.0);
    uint pk_rgba = packUnorm4x8(mix(old_c, avg, a));
    if (pk_rgba == color_buf[v]) return;

    color_buf[v] = pk_rgba;
    uint idx = atomicAdd(dirty_data[DR.base], 1u);
    // Bounds-checked: the region is sized from a running estimate, so an
    // unusually large dab can overrun it. The counter still counts, which is
    // how the CPU detects it and falls back — never silently truncate here.
    if (idx < DR.cap) dirty_data[DR.base + 1u + idx] = v;
}
