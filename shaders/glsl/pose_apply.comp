// pose_apply.comp — GLSL 430 sibling of shaders/wgsl/pose_apply.wgsl.
// Pass 2 of the pose brush, run once per dab: each captured vertex takes the
// weighted average of where the moving bones carry it (swung about their fixed
// sphere, stretched along their length), scaled by its strongest weight. Bones
// that stay put add weight but no motion. Damped by (1 - mask), like move.
// 3600-byte std140 Params UBO at binding 63.
#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 0)  buffer PosBuf               { float positions[]; };
layout(std430, binding = 8)  readonly buffer AffectedBuf { uint affected_count; uint affected_ids[]; };
layout(std430, binding = 11) readonly buffer InitBuf     { float move_init[]; };
layout(std430, binding = 12) readonly buffer MaskBuf     { float mask[]; };

struct Bone {
    vec4 a;    // joint A xyz at pen-down, .w = its radius
    vec4 b;    // joint B xyz at pen-down, .w = its radius
    vec4 f;    // the end that stays put, xyz; .w = 1 if this bone moves
    vec4 r0;   // rotation, column 0; .w = bone length at pen-down
    vec4 r1;   // rotation, column 1; .w = stretch along the bone
    vec4 r2;   // rotation, column 2
    vec4 u;    // unit axis, fixed end -> moving end, at pen-down
};

layout(std140, binding = 63) uniform Params {
    uint  bone_count;     // 0
    uint  vertex_count;   // 4
    float soft;           // 8
    uint  _pad0;          // 12
    Bone  bones[32];      // 16, 112 bytes each
} P;

float bone_weight(vec3 p, uint i) {
    vec3 a = P.bones[i].a.xyz;
    vec3 ab = P.bones[i].b.xyz - a;
    float len2 = max(dot(ab, ab), 1e-12);
    float t = clamp(dot(p - a, ab) / len2, 0.0, 1.0);
    float r = mix(P.bones[i].a.w, P.bones[i].b.w, t);
    float d = distance(p, a + ab * t);
    float edge = r * (1.0 + P.soft);
    if (d >= edge) return 0.0;
    if (d <= r) return 1.0;
    float x = (d - r) / max(edge - r, 1e-8);
    x = x * x * (3.0 - 2.0 * x);
    return 1.0 - x;
}

// Stretch along the bone's own length only: nothing stretches behind the fixed
// sphere, and past the moving one the region rides along rigidly.
vec3 bone_carry(vec3 p, uint i) {
    vec3 f = P.bones[i].f.xyz;
    vec3 u = P.bones[i].u.xyz;
    float len = P.bones[i].r0.w;
    float k = P.bones[i].r1.w - 1.0;
    vec3 q = p - f;
    float along = dot(q, u);
    float extra = 0.0;
    if (along > len)       extra = k * len;
    else if (along > 0.0)  extra = k * along;
    vec3 s = q + u * extra;
    return f + P.bones[i].r0.xyz * s.x + P.bones[i].r1.xyz * s.y + P.bones[i].r2.xyz * s.z;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= affected_count) return;
    uint v = affected_ids[idx];
    vec3 p = vec3(move_init[v*3u], move_init[v*3u+1u], move_init[v*3u+2u]);

    float wsum = 0.0, wmax = 0.0;
    vec3 acc = vec3(0.0);
    for (uint i = 0u; i < P.bone_count; i++) {
        float w = bone_weight(p, i);
        if (w <= 0.0) continue;
        wsum += w;
        wmax = max(wmax, w);
        if (P.bones[i].f.w > 0.5) acc += (bone_carry(p, i) - p) * w;
    }
    vec3 moved = wsum > 0.0 ? acc * (wmax / wsum) : vec3(0.0);
    vec3 dst = p + moved * (1.0 - mask[v]);

    positions[v*3u]      = dst.x;
    positions[v*3u + 1u] = dst.y;
    positions[v*3u + 2u] = dst.z;
}
