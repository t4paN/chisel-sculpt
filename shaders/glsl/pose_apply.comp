// pose_apply.comp — GLSL 430 sibling of shaders/wgsl/pose_apply.wgsl.
// The pose brush, run once per dab: each affected vertex takes the weighted sum of
// where the moving bones carry it (swung about their fixed sphere, stretched along
// their length). Ids, pen-down positions and weights come compact from the CPU
// binding (pose_bind, src/pose.cpp). The second four weights carry the vertex through
// the rig reflected in x = 0 (mirror on). Damped by (1 - mask), like move.
// 336-byte std140 Params UBO at binding 63.
#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 0)  buffer PosBuf               { float positions[]; };
layout(std430, binding = 8)  readonly buffer AffectedBuf { uint affected_count; uint affected_ids[]; };
layout(std430, binding = 9)  readonly buffer WBuf        { vec4 weights[]; };
layout(std430, binding = 11) readonly buffer InitBuf     { float init_pos[]; };
layout(std430, binding = 12) readonly buffer MaskBuf     { float mask[]; };

struct Bone {
    vec4 f;    // the end that stays put, xyz
    vec4 r0;   // rotation, column 0; .w = bone length at pen-down
    vec4 r1;   // rotation, column 1; .w = stretch along the bone
    vec4 r2;   // rotation, column 2
    vec4 u;    // unit axis, fixed end -> moving end, at pen-down
};

layout(std140, binding = 63) uniform Params {
    uint bone_count;       // 0   moving bones, at most 4
    uint affected_count;   // 4
    uint _pad0;            // 8
    uint _pad1;            // 12
    Bone bones[4];         // 16, 80 bytes each
} P;

// Stretch along the bone's own length only: nothing stretches behind the fixed
// sphere, and past the moving one the region rides along rigidly.
vec3 bone_carry(vec3 p, uint i) {
    vec3 f = P.bones[i].f.xyz;
    vec3 u = P.bones[i].u.xyz;
    float len = P.bones[i].r0.w;
    float k = P.bones[i].r1.w - 1.0;
    vec3 q = p - f;
    float along = dot(q, u);
    float extra = 0.0;
    if (along > len)       extra = k * len;
    else if (along > 0.0)  extra = k * along;
    vec3 s = q + u * extra;
    return f + P.bones[i].r0.xyz * s.x + P.bones[i].r1.xyz * s.y + P.bones[i].r2.xyz * s.z;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= P.affected_count) return;
    uint v = affected_ids[idx];
    vec3 p = vec3(init_pos[idx*3u], init_pos[idx*3u+1u], init_pos[idx*3u+2u]);
    vec4 w = weights[idx * 2u];
    vec4 wm = weights[idx * 2u + 1u];
    const vec3 flip = vec3(-1.0, 1.0, 1.0);

    vec3 moved = vec3(0.0);
    for (uint i = 0u; i < P.bone_count; i++) {
        moved += (bone_carry(p, i) - p) * w[i];
        moved += (bone_carry(p * flip, i) * flip - p) * wm[i];
    }
    vec3 dst = p + moved * (1.0 - mask[v]);

    positions[v*3u]      = dst.x;
    positions[v*3u + 1u] = dst.y;
    positions[v*3u + 2u] = dst.z;
}
