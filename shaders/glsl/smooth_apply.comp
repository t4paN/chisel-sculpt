// smooth_apply.comp — GLSL 430 sibling of shaders/wgsl/smooth_apply.wgsl.
// Pass 2 of the smooth brush, run once per iteration: a Laplacian over each touched
// vertex's 1-ring, each neighbour weighted by the surface it owns, squared (see
// owned()). The mirror seam crease is handled by re-imposing the X
// reflection after every iteration in dispatch_smooth (not by a normal projection in
// here — that variant pinched ridges/bumps under prolonged smoothing). 16-byte std140
// Params UBO at binding 63; tail slots are padding kept for shape parity.
#version 430
layout(local_size_x = 64) in;

layout(std430, binding = 0)  buffer PosBuf            { float positions[]; };
layout(std430, binding = 3)  readonly buffer AccumBuf { uint accum[]; };
layout(std430, binding = 2)  readonly buffer IdxBuf   { uint indices[]; };
layout(std430, binding = 4)  readonly buffer AdjOffset{ uint adj_offset[]; };
layout(std430, binding = 5)  readonly buffer AdjList  { uint adj_list[]; };
layout(std430, binding = 12) readonly buffer MaskBuf  { float mask[]; };

layout(std430, binding = 45) readonly buffer BlockListBuf { uint block_list[]; };

layout(std140, binding = 61) uniform DirtyRegion {
    uint base;
    uint cap;
    uint block_mode;   // 1 = one workgroup per active block
    uint _p1;
} DR;

layout(std140, binding = 63) uniform Params {
    uint  vertex_count;   // 0
    float strength;       // 4
    uint  _pad0;          // 8
    uint  _pad1;          // 12  (struct rounds to 16)
} P;

vec3 pos3(uint i) {
    return vec3(positions[i * 3u], positions[i * 3u + 1u], positions[i * 3u + 2u]);
}

// Surface a vertex owns: the summed (doubled) area of its triangles.
// A plain neighbour average packs the tris round a 5-edge vertex tight and spreads
// those round a 7-edge vertex wide, so every stroke used to pinch the poles the SDF
// remesh had just evened out. Weighting each neighbour by owned()^2 is that remesh's
// own rule (relax_to_field, even_area): a vertex is drawn toward neighbours holding
// too much surface and lets go of those holding too little. Where the tris are
// already even the weights are equal and this IS the plain average.
float owned(uint u) {
    float s = 0.0;
    uint b = adj_offset[u];
    uint e = adj_offset[u + 1u];
    for (uint j = b; j < e; j++) {
        uint t = adj_list[j];
        vec3 p0 = pos3(indices[t * 3u]);
        vec3 p1 = pos3(indices[t * 3u + 1u]);
        vec3 p2 = pos3(indices[t * 3u + 2u]);
        s += length(cross(p1 - p0, p2 - p0));
    }
    return s;
}

void main() {
    // Dispatch culling: one workgroup per ACTIVE block; entry 0 is the count, hence +1.
    uint v = (DR.block_mode == 1u)
           ? (block_list[1u + gl_WorkGroupID.x] * 64u + gl_LocalInvocationID.x)
           : gl_GlobalInvocationID.x;
    if (v >= P.vertex_count) return;

    float w = uintBitsToFloat(accum[v * 4u + 3u]);
    if (w <= 0.0) return;

    float mscale = 1.0 - mask[v];
    if (mscale <= 0.0) return;

    vec3 cur = pos3(v);

    // Own surface, only to bring the neighbours' into the range of 1 before squaring:
    // on a dense mesh a raw area squared is small enough to lose bits.
    float own = owned(v);
    if (own <= 0.0) return;
    float inv_own = 1.0 / own;

    vec3 sum = vec3(0.0);
    float wsum = 0.0;

    uint start = adj_offset[v];
    uint end = adj_offset[v + 1u];
    for (uint j = start; j < end; j++) {
        uint t = adj_list[j];
        uint i0 = indices[t * 3u];
        uint i1 = indices[t * 3u + 1u];
        uint i2 = indices[t * 3u + 2u];

        // The two corners that aren't v. Each neighbour turns up in two tris, so it
        // is counted twice, the same for all of them.
        uint na = i0;
        uint nb = i1;
        if (v == i0) {
            na = i1;
            nb = i2;
        } else if (v == i1) {
            nb = i2;
        }

        float ra = owned(na) * inv_own;
        float rb = owned(nb) * inv_own;
        float wa = ra * ra;
        float wb = rb * rb;
        sum += pos3(na) * wa + pos3(nb) * wb;
        wsum += wa + wb;
    }

    if (wsum <= 0.0) return;

    float blend = w * P.strength * mscale;
    vec3 moved = cur + (sum / wsum - cur) * blend;
    positions[v * 3u]      = moved.x;
    positions[v * 3u + 1u] = moved.y;
    positions[v * 3u + 2u] = moved.z;
}
